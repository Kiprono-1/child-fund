# PostgreSQL connection string used by Drizzle ORM (src/db/index.ts).
#
# Local development (stock PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ctf_app
#
# Managed Postgres — copy the connection string from your provider's dashboard.
#
# Neon (pooled endpoint, recommended): use the "Pooled connection" string
# (the "-pooler" host). Neon suspends idle computes, so the first connection
# after inactivity can take several seconds to wake; the pool's 30s connect
# timeout allows for this. node-postgres ignores the "channel_binding=require"
# param — it is safe to leave or remove.
#   DATABASE_URL=postgresql://[user]:[password]@ep-[id]-pooler.[region].aws.neon.tech/[db]?sslmode=require
#
# Supabase (alternative): use the Session-mode pooler (IPv4, Drizzle-friendly):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# SSL is auto-enabled for non-localhost hosts. Override if needed:
#   DATABASE_SSL=disable | no-verify | verify

# Used to sign session cookies for guardian accounts.
SESSION_SECRET=
